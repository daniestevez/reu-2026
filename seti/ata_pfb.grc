options:
  parameters:
    author: Daniel Estevez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ata_pfb
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ATA polyphase filterbank demo
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: a0
  id: variable
  parameters:
    comment: ''
    value: polyphase_taps[0*num_channels:1*num_channels][::-1]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 512.0]
    rotation: 0
    state: true
- name: a1
  id: variable
  parameters:
    comment: ''
    value: polyphase_taps[1*num_channels:2*num_channels][::-1]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1008, 512.0]
    rotation: 0
    state: true
- name: a2
  id: variable
  parameters:
    comment: ''
    value: polyphase_taps[2*num_channels:3*num_channels][::-1]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 584.0]
    rotation: 0
    state: true
- name: a3
  id: variable
  parameters:
    comment: ''
    value: polyphase_taps[3*num_channels:4*num_channels][::-1]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1008, 584.0]
    rotation: 0
    state: true
- name: doppler_drift
  id: variable
  parameters:
    comment: ''
    value: '1.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [992, 760.0]
    rotation: 0
    state: enabled
- name: duration
  id: variable
  parameters:
    comment: ''
    value: '300'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 360.0]
    rotation: 0
    state: true
- name: guppi_channels
  id: variable
  parameters:
    comment: ''
    value: '192'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [472, 1320.0]
    rotation: 0
    state: enabled
- name: num_channels
  id: variable
  parameters:
    comment: ''
    value: '4096'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 24.0]
    rotation: 0
    state: true
- name: num_taps
  id: variable
  parameters:
    comment: ''
    value: taps_per_channel * num_channels
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [576, 24.0]
    rotation: 0
    state: true
- name: polyphase_gain
  id: variable
  parameters:
    comment: ''
    value: num_channels * np.max(np.sum(polyphase_taps_i32.reshape(-1, num_taps),
      axis=0))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 176.0]
    rotation: 0
    state: true
- name: polyphase_taps
  id: variable
  parameters:
    comment: ''
    value: polyphase_taps_i32 / polyphase_gain
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [576, 176.0]
    rotation: 0
    state: true
- name: polyphase_taps_i32
  id: variable
  parameters:
    comment: ''
    value: np.fromfile('ata_pfb_coeffs.i32', 'int32')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [576, 96.0]
    rotation: 0
    state: true
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '2048000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [192, 16.0]
    rotation: 0
    state: enabled
- name: sawtooth_repeat
  id: variable
  parameters:
    comment: ''
    value: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [272, 528.0]
    rotation: 0
    state: enabled
- name: taps_per_channel
